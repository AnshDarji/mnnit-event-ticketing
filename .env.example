# Copy this file to .env. Generate a different random value for each secret.
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql+psycopg://mnnit:replace-with-a-random-hex-password@localhost:5432/mnnit
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
QR_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
INTERNAL_SECRET=replace-with-another-random-secret-of-at-least-32-characters
ENVIRONMENT=development
PILOT_ROLE_SELECTION=true
# Development only. Production refuses the synthetic identity endpoint.
DEMO_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
AUTH_SERVICE_URL=http://localhost:8001
EVENT_SERVICE_URL=http://localhost:8002
TICKETING_SERVICE_URL=http://localhost:8003
GATEWAY_URL=http://localhost:8000
# Frontend build-time values. Never place backend secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_DEMO_MODE=true
